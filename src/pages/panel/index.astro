---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { requireAuth } from '../../lib/auth';
import { listUpcomingAppointments } from '../../lib/db';

const authed = await requireAuth(Astro);
if (!authed) return Astro.redirect('/panel/login');

const appointments = await listUpcomingAppointments(env.DB);

const dateFormatter = new Intl.DateTimeFormat('pl-PL', {
  timeZone: 'Europe/Warsaw',
  weekday: 'short',
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const timeFormatter = new Intl.DateTimeFormat('pl-PL', {
  timeZone: 'Europe/Warsaw',
  hour: '2-digit',
  minute: '2-digit',
});

function dayKey(iso: string): string {
  return new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Warsaw' }).format(new Date(iso));
}

const groups: { key: string; label: string; items: typeof appointments }[] = [];
for (const appt of appointments) {
  const key = dayKey(appt.start_at);
  let group = groups.find((g) => g.key === key);
  if (!group) {
    group = { key, label: dateFormatter.format(new Date(appt.start_at)), items: [] };
    groups.push(group);
  }
  group.items.push(appt);
}
---

<BaseLayout title="Panel — Wizyty" description="Panel fryzjera — nadchodzące wizyty Parys Saint-Barber.">
  <section class="panel-section">
    <div class="panel-header">
      <h1 class="panel-title">Nadchodzące wizyty</h1>
      <button id="logout-btn" class="logout-btn">Wyloguj</button>
    </div>

    {appointments.length === 0 && (
      <p class="empty-state">Brak nadchodzących wizyt</p>
    )}

    {groups.map((group) => (
      <div class="day-group">
        <h2 class="day-label">{group.label}</h2>
        <div class="appt-list">
          {group.items.map((appt) => (
            <article class="appt-card" id={`appt-${appt.id}`} data-appt-id={appt.id}>
              <div class="appt-main">
                <p class="appt-time">{timeFormatter.format(new Date(appt.start_at))}</p>
                <p class="appt-service">{appt.service_name}</p>
                <p class="appt-client">{appt.client_name}</p>
                <p class="appt-phone">
                  <a href={`tel:${appt.client_phone}`} class="contact-link">{appt.client_phone}</a>
                </p>
              </div>
              <div class="appt-actions">
                <button class="cancel-btn" data-step="ask">Anuluj</button>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>

<script>
  const logoutBtn = document.getElementById('logout-btn') as HTMLButtonElement;
  logoutBtn.addEventListener('click', async () => {
    logoutBtn.disabled = true;
    try {
      await fetch('/api/auth/logout', { method: 'POST' });
    } finally {
      window.location.href = '/panel/login';
    }
  });

  document.querySelectorAll<HTMLButtonElement>('.cancel-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (btn.dataset.step === 'ask') {
        btn.dataset.step = 'confirm';
        btn.textContent = 'Na pewno?';
        btn.classList.add('cancel-btn--confirm');
        return;
      }

      const card = btn.closest('.appt-card') as HTMLElement;
      const id = card.dataset.apptId;
      btn.disabled = true;
      btn.textContent = 'Anulowanie…';

      try {
        const res = await fetch(`/api/appointments/${id}/cancel`, { method: 'POST' });
        if (res.ok) {
          card.classList.add('appt-card--cancelled');
          btn.textContent = 'Anulowano';
        } else {
          btn.disabled = false;
          btn.dataset.step = 'ask';
          btn.textContent = 'Anuluj';
          btn.classList.remove('cancel-btn--confirm');
        }
      } catch {
        btn.disabled = false;
        btn.dataset.step = 'ask';
        btn.textContent = 'Anuluj';
        btn.classList.remove('cancel-btn--confirm');
      }
    });
  });
</script>

<style>
  .panel-section {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    gap: 1rem;
  }

  .panel-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #111827;

    :global(.dark) & {
      color: var(--color-text-dark);
    }
  }

  .logout-btn {
    padding: 0.5rem 1rem;
    background-color: transparent;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #374151;
    cursor: pointer;
    flex-shrink: 0;

    &:hover {
      border-color: var(--color-accent-red);
      color: var(--color-accent-red);
    }

    :global(.dark) & {
      border-color: rgba(206, 171, 93, 0.3);
      color: var(--color-text-dark);
    }
  }

  .empty-state {
    text-align: center;
    color: #6b7280;
    padding: 3rem 1rem;
    font-size: 1rem;

    :global(.dark) & {
      color: #9ca3af;
    }
  }

  .day-group {
    margin-bottom: 2rem;
  }

  .day-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b7280;
    margin-bottom: 0.75rem;

    :global(.dark) & {
      color: #9ca3af;
    }
  }

  .appt-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .appt-card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-left: 3px solid var(--color-accent-gold);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);

    :global(.dark) & {
      background-color: var(--color-bg-surface-dark);
      border-color: rgba(206, 171, 93, 0.2);
      border-left-color: var(--color-accent-gold);
    }

    @media (min-width: 640px) {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
  }

  .appt-card--cancelled {
    opacity: 0.5;
  }

  .appt-main {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .appt-time {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-accent-gold);
  }

  .appt-service {
    font-size: 0.9375rem;
    color: #374151;

    :global(.dark) & {
      color: var(--color-text-dark);
    }
  }

  .appt-client {
    font-size: 0.9375rem;
    font-weight: 500;
    color: #111827;

    :global(.dark) & {
      color: var(--color-text-dark);
    }
  }

  .appt-phone {
    font-size: 0.875rem;
  }

  .contact-link {
    color: #6b7280;
    text-decoration: none;

    &:hover {
      color: var(--color-accent-gold);
    }

    :global(.dark) & {
      color: #9ca3af;
    }
  }

  .appt-actions {
    flex-shrink: 0;
  }

  .cancel-btn {
    padding: 0.5rem 1rem;
    background-color: transparent;
    border: 1px solid var(--color-accent-red);
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent-red);
    cursor: pointer;
    white-space: nowrap;

    &:hover {
      background-color: rgba(218, 41, 28, 0.08);
    }

    &:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
  }

  .cancel-btn--confirm {
    background-color: var(--color-accent-red);
    color: #ffffff;

    &:hover {
      opacity: 0.9;
      background-color: var(--color-accent-red);
    }
  }
</style>
