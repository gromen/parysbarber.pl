---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { requireAuth } from '../../lib/auth';
import {
  listUpcomingAppointments,
  listUpcomingBlocks,
  countRemindersSentToday,
  listBarberPushSubscriptions,
} from '../../lib/db';

const authed = await requireAuth(Astro);
if (!authed) return Astro.redirect('/panel/login');

const appointments = await listUpcomingAppointments(env.DB);
const blocks = await listUpcomingBlocks(env.DB);
const [reminderStats, barberSubs] = await Promise.all([
  countRemindersSentToday(env.DB),
  listBarberPushSubscriptions(env.DB),
]);
const clientRemindersSent = reminderStats.find((r) => r.kind === 'client_30')?.count ?? 0;
const barberRemindersSent = reminderStats.find((r) => r.kind === 'barber_15')?.count ?? 0;
const activeBarberDevices = barberSubs.length;

const timeOptions: string[] = [];
for (let minutes = 8 * 60; minutes <= 20 * 60; minutes += 15) {
  const h = String(Math.floor(minutes / 60)).padStart(2, '0');
  const m = String(minutes % 60).padStart(2, '0');
  timeOptions.push(`${h}:${m}`);
}

const dateFormatter = new Intl.DateTimeFormat('pl-PL', {
  timeZone: 'Europe/Warsaw',
  weekday: 'short',
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const timeFormatter = new Intl.DateTimeFormat('pl-PL', {
  timeZone: 'Europe/Warsaw',
  hour: '2-digit',
  minute: '2-digit',
});

function dayKey(iso: string): string {
  return new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Warsaw' }).format(new Date(iso));
}

type AppointmentItem = (typeof appointments)[number] & { kind: 'appointment' };
type BlockItem = (typeof blocks)[number] & { kind: 'block' };
type ScheduleItem = AppointmentItem | BlockItem;

const scheduleItems: ScheduleItem[] = [
  ...appointments.map((appt): AppointmentItem => ({ ...appt, kind: 'appointment' })),
  ...blocks.map((block): BlockItem => ({ ...block, kind: 'block' })),
].sort((a, b) => a.start_at.localeCompare(b.start_at));

const groups: { key: string; label: string; items: ScheduleItem[] }[] = [];
for (const item of scheduleItems) {
  const key = dayKey(item.start_at);
  let group = groups.find((g) => g.key === key);
  if (!group) {
    group = { key, label: dateFormatter.format(new Date(item.start_at)), items: [] };
    groups.push(group);
  }
  group.items.push(item);
}
---

<BaseLayout title="Panel — Wizyty" description="Panel fryzjera — nadchodzące wizyty Parys Saint-Barber.">
  <section class="panel-section">
    <div class="panel-header">
      <h1 class="panel-title">Nadchodzące wizyty</h1>
      <button id="logout-btn" class="logout-btn">Wyloguj</button>
    </div>

    <div class="block-form-card">
      <h2 class="block-form-title">Zablokuj godziny</h2>
      <form id="block-form" class="block-form">
        <div class="block-form-fields">
          <div class="field">
            <label for="block-date">Data</label>
            <input type="date" id="block-date" name="date" required />
          </div>
          <div class="field">
            <label for="block-start">Od</label>
            <select id="block-start" name="startTime" required>
              <option value="" disabled selected>--:--</option>
              {timeOptions.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="block-end">Do</label>
            <select id="block-end" name="endTime" required>
              <option value="" disabled selected>--:--</option>
              {timeOptions.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
        </div>
        <div id="block-form-message" class="form-message" role="alert"></div>
        <button type="submit" id="block-submit-btn" class="block-submit-btn">Zablokuj godziny</button>
      </form>
    </div>

    <div class="push-card">
      <div class="push-card-row">
        <div class="push-card-text">
          <h2 class="push-card-title">Powiadomienia na tym urządzeniu</h2>
          <p class="push-card-status" id="push-status">wyłączone</p>
        </div>
        <label class="push-toggle">
          <input type="checkbox" id="push-toggle-input" />
          <span class="push-toggle-slider"></span>
        </label>
      </div>
      <div id="push-message" class="form-message" role="alert"></div>
    </div>

    <div class="stats-card">
      <p class="stats-line">
        Wysłane dziś przypomnienia: <strong>{clientRemindersSent}</strong> klient / <strong>{barberRemindersSent}</strong> barber
      </p>
      <p class="stats-line">
        Aktywne urządzenia barbera: <strong>{activeBarberDevices}</strong>
      </p>
    </div>

    {scheduleItems.length === 0 && (
      <p class="empty-state">Brak nadchodzących wizyt</p>
    )}

    {groups.map((group) => (
      <div class="day-group">
        <h2 class="day-label">{group.label}</h2>
        <div class="appt-list">
          {group.items.map((item) => (
            item.kind === 'appointment' ? (
              <article class="appt-card" id={`appt-${item.id}`} data-appt-id={item.id}>
                <div class="appt-main">
                  <p class="appt-time">{timeFormatter.format(new Date(item.start_at))}</p>
                  <p class="appt-service">{item.service_name}</p>
                  <p class="appt-client">{item.client_name}</p>
                  <p class="appt-phone">
                    <a href={`tel:${item.client_phone}`} class="contact-link">{item.client_phone}</a>
                  </p>
                </div>
                <div class="appt-actions">
                  <button class="cancel-btn" data-step="ask">Anuluj</button>
                </div>
              </article>
            ) : (
              <article class="appt-card block-card" id={`block-${item.id}`} data-block-id={item.id}>
                <div class="appt-main">
                  <p class="appt-time">
                    {timeFormatter.format(new Date(item.start_at))}–{timeFormatter.format(new Date(item.end_at))}
                  </p>
                  <p class="appt-client block-label">Zablokowane</p>
                </div>
                <div class="appt-actions">
                  <button class="delete-block-btn" data-step="ask">Usuń</button>
                </div>
              </article>
            )
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>

<script>
  const logoutBtn = document.getElementById('logout-btn') as HTMLButtonElement;
  logoutBtn.addEventListener('click', async () => {
    logoutBtn.disabled = true;
    try {
      await fetch('/api/auth/logout', { method: 'POST' });
    } finally {
      window.location.href = '/panel/login';
    }
  });

  document.querySelectorAll<HTMLButtonElement>('.cancel-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (btn.dataset.step === 'ask') {
        btn.dataset.step = 'confirm';
        btn.textContent = 'Na pewno?';
        btn.classList.add('cancel-btn--confirm');
        return;
      }

      const card = btn.closest('.appt-card') as HTMLElement;
      const id = card.dataset.apptId;
      btn.disabled = true;
      btn.textContent = 'Anulowanie…';

      try {
        const res = await fetch(`/api/appointments/${id}/cancel`, { method: 'POST' });
        if (res.ok) {
          card.classList.add('appt-card--cancelled');
          btn.textContent = 'Anulowano';
        } else {
          btn.disabled = false;
          btn.dataset.step = 'ask';
          btn.textContent = 'Anuluj';
          btn.classList.remove('cancel-btn--confirm');
        }
      } catch {
        btn.disabled = false;
        btn.dataset.step = 'ask';
        btn.textContent = 'Anuluj';
        btn.classList.remove('cancel-btn--confirm');
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.delete-block-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (btn.dataset.step === 'ask') {
        btn.dataset.step = 'confirm';
        btn.textContent = 'Na pewno?';
        btn.classList.add('delete-block-btn--confirm');
        return;
      }

      const card = btn.closest('.block-card') as HTMLElement;
      const id = card.dataset.blockId;
      btn.disabled = true;
      btn.textContent = 'Usuwanie…';

      try {
        const res = await fetch(`/api/blocks/${id}`, { method: 'DELETE' });
        if (res.ok) {
          card.classList.add('appt-card--cancelled');
          btn.textContent = 'Usunięto';
        } else {
          btn.disabled = false;
          btn.dataset.step = 'ask';
          btn.textContent = 'Usuń';
          btn.classList.remove('delete-block-btn--confirm');
        }
      } catch {
        btn.disabled = false;
        btn.dataset.step = 'ask';
        btn.textContent = 'Usuń';
        btn.classList.remove('delete-block-btn--confirm');
      }
    });
  });

  const blockForm = document.getElementById('block-form') as HTMLFormElement;
  const blockSubmitBtn = document.getElementById('block-submit-btn') as HTMLButtonElement;
  const blockFormMessageEl = document.getElementById('block-form-message') as HTMLDivElement;

  blockForm.addEventListener('submit', async (event) => {
    event.preventDefault();

    blockFormMessageEl.textContent = '';
    blockFormMessageEl.classList.remove('is-error');

    const formData = new FormData(blockForm);
    const date = String(formData.get('date') ?? '');
    const startTime = String(formData.get('startTime') ?? '');
    const endTime = String(formData.get('endTime') ?? '');

    blockSubmitBtn.disabled = true;
    blockSubmitBtn.textContent = 'Blokowanie…';

    try {
      const res = await fetch('/api/blocks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ date, startTime, endTime }),
      });

      if (res.ok) {
        window.location.reload();
        return;
      }

      const errorData = (await res.json().catch(() => ({}))) as { error?: string };
      if (res.status === 409 && errorData.error === 'overlaps_appointment') {
        blockFormMessageEl.textContent = 'W tym przedziale masz już zarezerwowaną wizytę klienta.';
      } else {
        blockFormMessageEl.textContent = 'Nie udało się zablokować godzin. Spróbuj ponownie.';
      }
      blockFormMessageEl.classList.add('is-error');
    } catch {
      blockFormMessageEl.textContent = 'Nie udało się zablokować godzin. Spróbuj ponownie.';
      blockFormMessageEl.classList.add('is-error');
    } finally {
      blockSubmitBtn.disabled = false;
      blockSubmitBtn.textContent = 'Zablokuj godziny';
    }
  });

  const blockDateInput = document.getElementById('block-date') as HTMLInputElement;
  const blockStartSelect = document.getElementById('block-start') as unknown as HTMLSelectElement;
  const blockEndSelect = document.getElementById('block-end') as unknown as HTMLSelectElement;

  function localDateStr(d: Date): string {
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  function applyPastTimeFilter() {
    const now = new Date();
    blockDateInput.min = localDateStr(now);

    const isToday = blockDateInput.value === localDateStr(now);
    const nowMinutes = now.getHours() * 60 + now.getMinutes();
    const remainder = nowMinutes % 15;
    const nextSlotMinutes = remainder === 0 ? nowMinutes : nowMinutes + (15 - remainder);

    for (const select of [blockStartSelect, blockEndSelect]) {
      let selectedHidden = false;
      for (const option of Array.from(select.options)) {
        if (!option.value) continue;
        const [h, m] = option.value.split(':').map(Number);
        const optionMinutes = h * 60 + m;
        const shouldHide = isToday && optionMinutes < nextSlotMinutes;
        option.hidden = shouldHide;
        if (shouldHide && option.selected) selectedHidden = true;
      }
      if (selectedHidden) select.selectedIndex = 0;
    }
  }

  applyPastTimeFilter();
  blockDateInput.addEventListener('change', applyPastTimeFilter);

  const pushToggleInput = document.getElementById('push-toggle-input') as HTMLInputElement;
  const pushStatusEl = document.getElementById('push-status') as HTMLParagraphElement;
  const pushMessageEl = document.getElementById('push-message') as HTMLDivElement;

  const PUSH_STATUS_LABELS = {
    on: 'włączone',
    denied: 'brak zgody',
    unsupported: 'nieobsługiwane',
    off: 'wyłączone',
  } as const;

  function setPushStatus(status: keyof typeof PUSH_STATUS_LABELS) {
    pushStatusEl.textContent = PUSH_STATUS_LABELS[status];
  }

  function clearPushMessage() {
    pushMessageEl.textContent = '';
    pushMessageEl.classList.remove('is-error');
  }

  function showPushError(text: string) {
    pushMessageEl.textContent = text;
    pushMessageEl.classList.add('is-error');
  }

  function urlBase64ToUint8Array(base64String: string): Uint8Array {
    const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
    const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    const rawData = atob(base64);
    const outputArray = new Uint8Array(rawData.length);
    for (let i = 0; i < rawData.length; i++) {
      outputArray[i] = rawData.charCodeAt(i);
    }
    return outputArray;
  }

  async function initPushToggle() {
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
      setPushStatus('unsupported');
      pushToggleInput.disabled = true;
      return;
    }

    if (Notification.permission === 'denied') {
      setPushStatus('denied');
    }

    try {
      const registration = await navigator.serviceWorker.ready;
      const subscription = await registration.pushManager.getSubscription();
      if (subscription) {
        pushToggleInput.checked = true;
        setPushStatus('on');
      }
    } catch {
      // leave default state
    }
  }

  async function enablePush() {
    const permission = Notification.requestPermission();
    const result = await permission;
    if (result !== 'granted') {
      setPushStatus('denied');
      pushToggleInput.checked = false;
      return;
    }

    try {
      const registration = await navigator.serviceWorker.ready;
      const keyRes = await fetch('/api/push/vapid-public-key');
      if (!keyRes.ok) throw new Error('vapid_key_failed');
      const { key } = (await keyRes.json()) as { key: string };

      const subscription = await registration.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: urlBase64ToUint8Array(key) as BufferSource,
      });

      const subscribeRes = await fetch('/api/push/subscribe', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ role: 'barber', subscription: subscription.toJSON() }),
      });

      if (!subscribeRes.ok) throw new Error('subscribe_failed');

      clearPushMessage();
      setPushStatus('on');
    } catch {
      showPushError('Nie udało się włączyć powiadomień. Spróbuj ponownie.');
      pushToggleInput.checked = false;
      setPushStatus('off');
    }
  }

  async function disablePush() {
    try {
      const registration = await navigator.serviceWorker.ready;
      const subscription = await registration.pushManager.getSubscription();

      if (subscription) {
        await subscription.unsubscribe();
        await fetch('/api/push/subscribe', {
          method: 'DELETE',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ endpoint: subscription.endpoint }),
        });
      }

      clearPushMessage();
      setPushStatus('off');
    } catch {
      showPushError('Nie udało się wyłączyć powiadomień. Spróbuj ponownie.');
      pushToggleInput.checked = true;
      setPushStatus('on');
    }
  }

  pushToggleInput.addEventListener('change', () => {
    clearPushMessage();
    if (pushToggleInput.checked) {
      void enablePush();
    } else {
      void disablePush();
    }
  });

  void initPushToggle();
</script>

<style>
  .panel-section {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    gap: 1rem;
  }

  .panel-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #111827;

    :global(.dark) & {
      color: var(--color-text-dark);
    }
  }

  .logout-btn {
    padding: 0.5rem 1rem;
    background-color: transparent;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #374151;
    cursor: pointer;
    flex-shrink: 0;

    &:hover {
      border-color: var(--color-accent-red);
      color: var(--color-accent-red);
    }

    :global(.dark) & {
      border-color: rgba(206, 171, 93, 0.3);
      color: var(--color-text-dark);
    }
  }

  .empty-state {
    text-align: center;
    color: #6b7280;
    padding: 3rem 1rem;
    font-size: 1rem;

    :global(.dark) & {
      color: #9ca3af;
    }
  }

  .block-form-card {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);

    :global(.dark) & {
      background-color: var(--color-bg-surface-dark);
      border-color: rgba(206, 171, 93, 0.2);
    }
  }

  .block-form-title {
    font-size: 1rem;
    font-weight: 600;
    color: #111827;
    margin-bottom: 0.75rem;

    :global(.dark) & {
      color: var(--color-text-dark);
    }
  }

  .block-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .block-form-fields {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;

    @media (min-width: 640px) {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;

    label {
      font-size: 0.8125rem;
      font-weight: 500;
      color: #374151;

      :global(.dark) & {
        color: var(--color-text-dark);
      }
    }

    input,
    select {
      padding: 0.5rem 0.75rem;
      border: 1px solid #d1d5db;
      border-radius: 0.5rem;
      font-size: 0.9375rem;
      background-color: #ffffff;
      color: #111827;

      :global(.dark) & {
        background-color: var(--color-bg-dark);
        border-color: rgba(206, 171, 93, 0.2);
        color: var(--color-text-dark);
      }

      &:focus {
        outline: 2px solid var(--color-accent-gold);
        outline-offset: 1px;
      }
    }
  }

  .form-message {
    font-size: 0.9375rem;
    min-height: 1.25rem;

    &.is-error {
      color: var(--color-accent-red);
    }
  }

  .block-submit-btn {
    align-self: flex-start;
    padding: 0.625rem 1.25rem;
    border-radius: 0.5rem;
    border: none;
    background-color: var(--color-accent-gold);
    color: #111827;
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;

    &:hover {
      opacity: 0.9;
    }

    &:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
  }

  .push-card {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);

    :global(.dark) & {
      background-color: var(--color-bg-surface-dark);
      border-color: rgba(206, 171, 93, 0.2);
    }
  }

  .push-card-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .push-card-title {
    font-size: 1rem;
    font-weight: 600;
    color: #111827;

    :global(.dark) & {
      color: var(--color-text-dark);
    }
  }

  .push-card-status {
    font-size: 0.8125rem;
    color: #6b7280;
    margin-top: 0.125rem;

    :global(.dark) & {
      color: #9ca3af;
    }
  }

  .push-toggle {
    position: relative;
    display: inline-block;
    width: 2.75rem;
    height: 1.5rem;
    flex-shrink: 0;

    input {
      opacity: 0;
      width: 0;
      height: 0;

      &:checked + .push-toggle-slider {
        background-color: var(--color-accent-gold);
      }

      &:checked + .push-toggle-slider::before {
        transform: translateX(1.25rem);
      }

      &:disabled + .push-toggle-slider {
        opacity: 0.5;
        cursor: not-allowed;
      }
    }
  }

  .push-toggle-slider {
    position: absolute;
    inset: 0;
    background-color: #d1d5db;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 0.15s ease;

    :global(.dark) & {
      background-color: rgba(206, 171, 93, 0.3);
    }

    &::before {
      content: '';
      position: absolute;
      left: 0.1875rem;
      top: 0.1875rem;
      width: 1.125rem;
      height: 1.125rem;
      background-color: #ffffff;
      border-radius: 50%;
      transition: transform 0.15s ease;
    }
  }

  .stats-card {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;

    :global(.dark) & {
      background-color: var(--color-bg-surface-dark);
      border-color: rgba(206, 171, 93, 0.2);
    }
  }

  .stats-line {
    font-size: 0.875rem;
    color: #374151;

    strong {
      color: #111827;
      font-weight: 600;
    }

    :global(.dark) & {
      color: #9ca3af;

      strong {
        color: var(--color-text-dark);
      }
    }
  }

  .day-group {
    margin-bottom: 2rem;
  }

  .day-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b7280;
    margin-bottom: 0.75rem;

    :global(.dark) & {
      color: #9ca3af;
    }
  }

  .appt-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .appt-card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-left: 3px solid var(--color-accent-gold);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);

    :global(.dark) & {
      background-color: var(--color-bg-surface-dark);
      border-color: rgba(206, 171, 93, 0.2);
      border-left-color: var(--color-accent-gold);
    }

    @media (min-width: 640px) {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
