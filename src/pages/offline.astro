---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { WifiOff } from '@lucide/astro';
---

<BaseLayout
  title="Brak połączenia — Parys Saint-Barber"
  description="Wygląda na to, że nie masz teraz połączenia z internetem. Sprawdź sieć i spróbuj ponownie."
>
  <section class="py-24 px-4 max-w-2xl mx-auto text-center">
    <div class="offline-icon-wrap" aria-hidden="true">
      <WifiOff class="w-10 h-10" aria-hidden="true" />
    </div>

    <h1 class="text-4xl md:text-5xl font-bold mb-4">Brak połączenia z internetem</h1>
    <p class="text-gray-600 dark:text-gray-400 text-lg mb-8">
      Nie udało się połączyć z siecią. Sprawdź swoje połączenie Wi-Fi lub dane mobilne
      i spróbuj ponownie — reszta strony wróci, gdy tylko internet będzie dostępny.
    </p>

    <button type="button" class="retry-button" onclick="window.location.reload()">
      Spróbuj ponownie
    </button>
  </section>
</BaseLayout>

<style>
  .offline-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    margin-bottom: 1.5rem;
    border-radius: 9999px;
    background-color: color-mix(in srgb, var(--color-accent-gold) 15%, transparent);
    color: var(--color-accent-gold);
  }

  .retry-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 2rem;
    font-weight: 600;
    color: var(--color-bg-dark);
    background-color: var(--color-accent-gold);
    border-radius: 0.5rem;
    transition: opacity 0.2s;

    &:hover {
      opacity: 0.85;
    }
  }
</style>
